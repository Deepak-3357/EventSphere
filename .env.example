# Supabase project configuration (server-side use only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_HOST=db.<project-ref>.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
DATABASE_SSLMODE=require
FRONTEND_ORIGIN=http://127.0.0.1:5500
# Optional comma-delimited exact origins, e.g. https://preview.example.com,https://staging.example.com
FRONTEND_ALLOWED_ORIGINS=
OD_VERIFICATION_SECRET=generate-a-long-random-local-secret

# Flask configuration
FLASK_ENV=development
FLASK_DEBUG=1
